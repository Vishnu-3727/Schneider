# Copy to .env and adjust. NEVER commit .env (only .env.example is committed).
# Phase 1 config — no secrets, no hard-coded URLs in code.
DATABASE_URL=postgresql+psycopg://joulemitra:joulemitra@localhost:5432/joulemitra
TEST_DATABASE_URL=postgresql+psycopg://joulemitra:joulemitra@localhost:5432/joulemitra_test
API_BASE_URL=http://localhost:8000
TZ=Asia/Kolkata
# Telemetry older than this (seconds) is flagged SUSPECT (stale).
STALE_AFTER_S=900
# Timestamps further in the future than this (seconds) are flagged BAD (clock skew tolerance).
CLOCK_SKEW_S=300
# power_kw above RATED_POWER_KW * this multiple is flagged SUSPECT (spike).
SPIKE_MULTIPLE=1.5
