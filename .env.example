# Copy to .env and adjust. NEVER commit .env (only .env.example is committed).
# Phase 1 config — no secrets, no hard-coded URLs in code.
DATABASE_URL=postgresql+psycopg://joulemitra:joulemitra@localhost:5432/joulemitra
TEST_DATABASE_URL=postgresql+psycopg://joulemitra:joulemitra@localhost:5432/joulemitra_test
API_BASE_URL=http://localhost:8000
TZ=Asia/Kolkata
# Telemetry older than this (seconds) is flagged SUSPECT (stale).
STALE_AFTER_S=900
# Timestamps further in the future than this (seconds) are flagged BAD (clock skew tolerance).
CLOCK_SKEW_S=300
# power_kw above RATED_POWER_KW * this multiple is flagged SUSPECT (spike).
SPIKE_MULTIPLE=1.5
# --- Phase 2: energy analytics (all thresholds configurable; analytics code uses these, no magic numbers) ---
# Fixed aggregation interval in seconds (default 1 h).
ENERGY_INTERVAL_S=3600
# Minimum telemetry duration-coverage % for an interval to count as complete.
MIN_COVERAGE_PCT=80.0
# Minimum number of NORMAL complete intervals required to fit a baseline.
MIN_BASELINE_INTERVALS=24
# Fraction of training intervals held out for validation (time-ordered tail).
BASELINE_HOLDOUT_FRACTION=0.2
# Expected-energy floor (kWh): expected <= this -> deviation_pct = null (never inf/NaN).
EXPECTED_EPSILON_KWH=0.5
# L1 deviation rule thresholds (% above expected baseline) + consecutive intervals N.
DEVIATION_WARN_PCT=15.0
DEVIATION_CRIT_PCT=30.0
DEVIATION_CONSECUTIVE_N=2
# L1 idle-energy rule: idle/holding hour share with zero production, sustained
# for IDLE_CONSECUTIVE_N intervals (exceeds the longest legitimate melt-free span).
IDLE_SHARE_THRESHOLD=0.5
IDLE_CONSECUTIVE_N=4
# L1 power rule: max power_kw above rated * multiple.
RATED_POWER_MULTIPLE=1.1
# L1 power-factor rule: interval mean PF below this.
PF_MIN_THRESHOLD=0.6
# L2 statistical rule: rolling median + MAD robust z-score threshold / window (intervals).
MAD_THRESHOLD=4.0
MAD_WINDOW=24
# Comma-separated machine types with no production concept (SEC NOT_APPLICABLE).
NON_PRODUCTION_TYPES=pump,compressor
# Baseline model version string stored with each fit.
BASELINE_MODEL_VERSION=v1-linear
# ASHRAE Guideline 14 hourly acceptance: CV(RMSE) <= this % and |NMBE| <= NMBE max.
G14_CV_MAX_PCT=30.0
G14_NMBE_MAX_PCT=10.0
