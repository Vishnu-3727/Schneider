{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TelemetryRecord",
  "description": "JSON-schema mirror of apps.backend.schemas.TelemetryRecord (Phase 1). Units are in field names; ts must carry a timezone offset; source tag required.",
  "type": "object",
  "additionalProperties": false,
  "required": ["machine_id", "ts", "source"],
  "properties": {
    "machine_id": {"type": "string"},
    "ts": {"type": "string", "format": "date-time", "description": "Timezone-aware timestamp"},
    "voltage_v": {"type": ["number", "null"]},
    "current_a": {"type": ["number", "null"]},
    "power_kw": {"type": ["number", "null"]},
    "reactive_power_kvar": {"type": ["number", "null"]},
    "power_factor": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "energy_kwh": {"type": ["number", "null"], "description": "Cumulative counter, kWh"},
    "vibration_mm_s": {"type": ["number", "null"]},
    "temperature_c": {"type": ["number", "null"]},
    "rpm": {"type": ["number", "null"]},
    "runtime_h": {"type": ["number", "null"]},
    "machine_state": {"type": ["string", "null"], "enum": ["heating", "melting", "holding", "idle", "shutdown", "auxiliary", "running", "stopped", null]},
    "source": {"type": "string", "enum": ["MEASURED", "SIMULATED", "DERIVED", "EXTERNAL_REFERENCE", "PROJECTED", "ASSUMPTION"]}
  }
}
